---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { KNOWLEDGE_ISLANDS } from '../../lib/teaching/registry';
---

<ToolLayout title="教学宇宙 · Learning Universe" description="跨学科交互式学习大厅">
  <section class="tu">
    <header class="tu-head">
      <h1>教学宇宙</h1>
      <p>
        从直觉到证明、从基础到研究专题。高级内容默认隐藏，完成必要基础或开启开关后出现。
        进度保存在本机 IndexedDB。
      </p>
      <div class="tu-links">
        <a href="/lab/?tab=teaching">知识之海地图</a>
        <a href="/lab/?tab=compilers">编译器实验室</a>
        <a href="/python/">Python IDE</a>
        <a href="/avr/">AVR 汇编</a>
      </div>
    </header>

    <ul class="tu-grid">
      {
        KNOWLEDGE_ISLANDS.map((island) => (
          <li>
            <a class="tu-card" href={`/teaching/${island.id}`}>
              <span class="tu-title">{island.title}</span>
              <span class="tu-tag">{island.tagline}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</ToolLayout>

<style>
  .tu {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    color: var(--text);
  }
  .tu-head h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl, 1.75rem);
  }
  .tu-head p {
    margin: 0 0 var(--space-4);
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 40rem;
  }
  .tu-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .tu-links a {
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .tu-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }
  .tu-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    min-height: 6.5rem;
    transition: border-color 0.15s ease;
  }
  .tu-card:hover {
    border-color: var(--accent);
  }
  .tu-title {
    font-weight: 650;
    font-size: var(--text-base);
  }
  .tu-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
